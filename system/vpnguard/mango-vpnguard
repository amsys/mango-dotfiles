# ------------------------------------------------------------------- go live

# A chain entry only carries the default route when its allowed-ips include a
# default AND NetworkManager is allowed to install one. A split entry has
# neither, or has ipv4.never-default=yes, which tells NM to take the routes
# but never the default. Arming with only split entries opted in produces a
# machine that blocks every public destination and has no tunnel willing to
# carry it: the guard is working perfectly and the user is offline.
default_capable() { # <name> -> 0 when this entry can own the default route
	case "$("$NMCLI_BIN" -g ipv4.never-default connection show "$1" 2>/dev/null)" in
	yes) return 1 ;;
	esac
	_oldIFS=$IFS
	IFS='
'
	set -f
	_ok=1
	for _p in $(conn_routes "$1"); do
		case "$_p" in
		0.0.0.0/0 | ::/0) _ok=0 ;;
		esac
	done
	set +f
	IFS=$_oldIFS
	return $_ok
}

# Proves that traffic actually leaves through a tunnel, rather than trusting
# that `arm` returned 0. Three independent facts, because each one alone has
# a false positive: a default route can exist over a dead tunnel, a handshake
# can be fresh on a tunnel that owns no default route, and NM's connectivity
# check can pass through a captive portal's own web server.
verify_egress() {
	_dev=$("$IP_BIN" route show default 2>/dev/null | awk '/^default/{print $5; exit}')
	[ -n "$_dev" ] || {
		warn "verify: no default route at all"
		return 1
	}
	case "$("$WG_BIN" show interfaces 2>/dev/null)" in
	*"$_dev"*) : ;;
	*)
		warn "verify: default route is on $_dev, which is not a WireGuard device"
		return 1
		;;
	esac
	_hs=$("$WG_BIN" show "$_dev" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')
	[ -n "$_hs" ] && [ "$_hs" -gt 0 ] 2>/dev/null || {
		warn "verify: $_dev has never handshaked"
		return 1
	}
	_age=$(( $(date +%s) - _hs ))
	[ "$_age" -lt 180 ] || {
		warn "verify: $_dev handshake is ${_age}s old"
		return 1
	}
	"$NMCLI_BIN" networking connectivity check >/dev/null 2>&1
	case "$("$NMCLI_BIN" -t -f CONNECTIVITY general 2>/dev/null | head -1)" in
	full) : ;;
	*)
		warn "verify: NetworkManager connectivity is not 'full'"
		return 1
		;;
	esac
	echo "verified: default route on $_dev, handshake ${_age}s ago, connectivity full"
}

# `go` is `auto` with a precondition and a proof, for the case where being
# wrong means losing the network on a machine that is far from home. It
# refuses to arm what cannot work, installs a rollback timer before it closes
# anything, and disarms itself if egress cannot be proved afterwards.
cmd_go() {
	_rollback="${MANGO_VG_ROLLBACK:-180}"
	_self=$(readlink -f "$0")

	if [ -z "$(vpn_chain)" ]; then
		echo "mango-vpnguard: no profile is opted into the chain — nothing to dial" >&2
		echo "  nmcli connection modify \"<name>\" connection.autoconnect-priority 100" >&2
		exit 1
	fi

	_winner=""
	_oldIFS=$IFS
	IFS='
'
	set -f
	for _n in $(vpn_chain); do
		if default_capable "$_n"; then
			_winner=$_n
			break
		fi
	done
	set +f
	IFS=$_oldIFS

	if [ -z "$_winner" ]; then
		echo "mango-vpnguard: refusing to arm — no chain entry can carry the default route" >&2
		echo "  Every opted-in profile is split-tunnel: allowed-ips has no 0.0.0.0/0," >&2
		echo "  or ipv4.never-default is yes. Arming would block every public" >&2
		echo "  destination with no tunnel willing to carry it, which is an offline" >&2
		echo "  machine, not a protected one." >&2
		echo "  Full-tunnel profiles available to opt in:" >&2
		_oldIFS=$IFS
		IFS='
'
		set -f
		for _n in $(wg_conns | cut -d"$TAB" -f3); do
			default_capable "$_n" &&
				echo "    nmcli connection modify \"$_n\" connection.autoconnect-priority 200" >&2
		done
		set +f
		IFS=$_oldIFS
		exit 1
	fi

	echo "go: '$_winner' can carry the default route"

	# The rollback timer is armed BEFORE anything closes, so a hang, a kill or
	# a dead tunnel all end the same way: open, after $_rollback seconds.
	systemd-run --unit=mango-vpnguard-rollback --on-active="$_rollback" --collect \
		"$_self" disarm >/dev/null 2>&1 ||
		warn "could not arm the rollback timer — disarm by hand if this goes wrong"
	echo "go: rollback armed, disarms in ${_rollback}s unless this succeeds"

	cmd_auto

	if verify_egress; then
		systemctl stop mango-vpnguard-rollback.timer >/dev/null 2>&1 || true
		systemctl reset-failed mango-vpnguard-rollback.service >/dev/null 2>&1 || true
		echo "go: armed and proved. State: $(state_read)"
	else
		echo "mango-vpnguard: egress could not be proved — rolling back now" >&2
		systemctl stop mango-vpnguard-rollback.timer >/dev/null 2>&1 || true
		systemctl reset-failed mango-vpnguard-rollback.service >/dev/null 2>&1 || true
		cmd_disarm
		exit 1
	fi
}

cmd_devices() { # -> one managed interface name per line, for the NM dispatcher
	{ vpn_chain
	vpn_always; } | while IFS= read -r name; do
		[ -n "$name" ] || continue
		conn_dev "$name"
	done | sort -u
}

cmd_list() {
	rows=$(wg_conns | while IFS="$TAB" read -r prio ac name; do
		[ -n "$name" ] || continue
		if [ "${prio:-0}" -gt 0 ] 2>/dev/null; then
			role=default
		elif [ "$ac" = yes ]; then
			role=always
		else
			continue
		fi
		printf '%s\t%s\t%s\t%s\n' "${prio:-0}" "$role" "$(conn_dev "$name")" "$name"
	done)
	# Chain entries first, highest priority first (net.sh numbers them in this
	# order); always-on companions after, order among themselves unimportant.
	printf '%s\n' "$rows" | awk -F"$TAB" '$2=="default"' | sort -t"$TAB" -k1,1nr
	printf '%s\n' "$rows" | awk -F"$TAB" '$2=="always"'
}

# ---------------------------------------------------------------- status / test

# One sentence for the state token, for a human reading a terminal. Nothing
# parses this: net.sh and net.rs read $STATE_FILE directly for the token
# itself (`install.sh` is the only caller of this verb, and only checks the
# exit code), so the wording here is free to change.
cmd_status() {
	st=$(state_read)
	case "$st" in
	vpn:*) echo "protected — ${st#vpn:}" ;;
	blocked) echo "blocked — nothing can leave until a tunnel connects" ;;
	portal) echo "sign-in needed — captive portal on this network" ;;
	unsecured) echo "not protected — traffic is leaving in the clear" ;;
	unconfigured) echo "not protected — no tunnel chosen yet" ;;
	*) echo "not running — no state recorded" ;;
	esac
}

cmd_help() {
	cat <<-'EOF'
		usage: mango-vpnguard <verb>

		  arm                 deny-by-default, LAN/DHCP/dial-ports only
		  disarm              open the guard unconditionally
		  protect             forget any opt-out, arm and dial on this network
		  unsecure            open the guard, remember this uplink
		  portal              relax for a captive-portal login
		  portal-close        re-tighten once connectivity is full
		  up                  dial one chain entry ('CONN=<name>' on stdin)
		  auto                dispatcher entry point: arm/portal/dial as needed
		  go                  arm only if a full tunnel exists, then prove egress
		  devices             print every managed interface name
		  list                print the managed profiles, one per line
		  status              print the current state, as a sentence
		  test                self-check, no root needed

		state (in /run/mango-vpnguard/state):
		  vpn:<name>    protected — <name> is carrying outgoing traffic
		  blocked       nothing can leave until a tunnel connects
		  portal        captive portal — sign in, then it dials out
		  unsecured     not protected — traffic is leaving in the clear
		  unconfigured  not protected — no tunnel chosen yet
	EOF
}

cmd_test() {
	for b in "$NFT_BIN" "$NMCLI_BIN" "$WG_BIN" "$IP_BIN"; do
		command -v "$b" >/dev/null 2>&1 || {
			echo "mango-vpnguard test: missing binary: $b" >&2
			exit 1
		}
	done

	valid_endpoint 203.0.113.10:51820 || {
		echo "valid_endpoint should accept host:port"
		exit 1
	}
	valid_endpoint 203.0.113.10:0 && {
		echo "valid_endpoint should reject port 0"
		exit 1
	}
	valid_endpoint 203.0.113.10:70000 && {
		echo "valid_endpoint should reject port > 65535"
		exit 1
	}
	valid_endpoint 203.0.113.10 && {
		echo "valid_endpoint should reject a missing port"
		exit 1
	}
	valid_endpoint '203.0.113.10:51820;reboot' && {
		echo "valid_endpoint should reject a shell metacharacter"
		exit 1
	}

	[ "$(unescape '2001\:db8\:\:1/128')" = "2001:db8::1/128" ] || {
		echo "unescape should turn 2001\\:db8\\:\\:1/128 into 2001:db8::1/128"
		exit 1
	}
	[ "$(unescape '149.88.19.225\:51820')" = "149.88.19.225:51820" ] || {
		echo "unescape should turn an escaped endpoint colon into a plain one"
		exit 1
	}

	[ "$(uri_host 'http://198.51.100.7/.well-known/gen_204')" = 198.51.100.7 ] || {
		echo "uri_host should strip the scheme and the path"
		exit 1
	}
	[ "$(uri_host 'https://probe.example.net:443/x')" = probe.example.net ] || {
		echo "uri_host should keep a host that carries an explicit port 443"
		exit 1
	}
	[ "$(uri_host 'http://u:p@probe.example.net/x')" = probe.example.net ] || {
		echo "uri_host should strip userinfo"
		exit 1
	}
	[ -z "$(uri_host 'http://probe.example.net:8080/x')" ] || {
		echo "uri_host should refuse a port the guard does not open"
		exit 1
	}
	[ -z "$(uri_host 'http://[2001:db8::1]/x')" ] || {
		echo "uri_host should refuse an IPv6 literal — probes4 is IPv4"
		exit 1
	}
	[ -z "$(uri_host '')" ] || {
		echo "uri_host should return nothing for an unset URI"
		exit 1
	}

	T=$(mktemp -d)
	trap 'rm -rf "$T"' EXIT
	mkdir -p "$T/bin"

	# The probe hole must follow NM's merged configuration, conf.d drop-ins
	# included, which is exactly what `--print-config` prints.
	cat >"$T/bin/NetworkManager" <<-'EOF'
		#!/bin/sh
		printf '[main]\nuri=http://decoy.invalid/x\n\n[connectivity]\nuri=http://198.51.100.7/gen_204\n\n[logging]\nuri=http://decoy2.invalid/x\n'
	EOF
	chmod +x "$T/bin/NetworkManager"
	NM_BIN="$T/bin/NetworkManager"
	[ "$(nm_connectivity_uri)" = "http://198.51.100.7/gen_204" ] || {
		echo "nm_connectivity_uri should read uri= from the [connectivity] section only"
		echo "got: $(nm_connectivity_uri)"
		exit 1
	}

	# STATE_FILE etc. were already expanded from the old RUN_DIR at
	# top-level parse time, so the paths derived from it need re-pointing.
	RUN_DIR="$T/run"
	STATE_FILE="$RUN_DIR/state"
	UPLINK_FILE="$RUN_DIR/uplink"
	UNSECURED_FILE="$RUN_DIR/unsecured-key"
	LOCK_FILE="$RUN_DIR/lock"

	state_write "vpn:ProtonVPN (DE317)"
	[ "$(state_read)" = "vpn:ProtonVPN (DE317)" ] || {
		echo "state round-trip failed for a name with a space and parens"
		exit 1
	}

	# --- wg_conns / vpn_chain / vpn_always against a fixture nmcli ---
	cat >"$T/bin/nmcli" <<-'EOF'
		#!/bin/sh
		case "$*" in
		"-t -f NAME,TYPE connection show")
			printf 'Test VPN:wireguard\nProtonVPN (DE317):wireguard\nHome Gateway:wireguard\nIdle VPN:wireguard\nOther:vpn\n' ;;
		"-g connection.autoconnect-priority connection show Test VPN") echo 10 ;;
		"-g connection.autoconnect-priority connection show ProtonVPN (DE317)") echo 20 ;;
		"-g connection.autoconnect-priority connection show Home Gateway") echo 0 ;;
		"-g connection.autoconnect-priority connection show Idle VPN") echo 0 ;;
		"-g connection.autoconnect connection show Test VPN") echo no ;;
		"-g connection.autoconnect connection show ProtonVPN (DE317)") echo no ;;
		"-g connection.autoconnect connection show Home Gateway") echo yes ;;
		"-g connection.autoconnect connection show Idle VPN") echo no ;;
		"-g connection.interface-name connection show Test VPN") echo wg_test ;;
		"-g connection.interface-name connection show ProtonVPN (DE317)") echo wg_de317 ;;
		"-g connection.interface-name connection show Home Gateway") echo wg_home ;;
		"-g wireguard.peers connection show Test VPN")
			printf '%s\n' 'K1= allowed-ips=0.0.0.0/0 endpoint=203.0.113.10\:51820 persistent-keepalive=25' ;;
		"-g wireguard.peers connection show ProtonVPN (DE317)")
			printf '%s\n' 'K2= allowed-ips=0.0.0.0/0;::/0 endpoint=149.88.19.225\:51820 persistent-keepalive=25' ;;
		"-g wireguard.peers connection show Home Gateway")
			printf '%s\n' 'K3= allowed-ips=10.0.0.0/16 endpoint=203.0.113.20\:51820 persistent-keepalive=25' ;;
		esac
	EOF
	chmod +x "$T/bin/nmcli"
	NMCLI_BIN="$T/bin/nmcli"

	[ "$(vpn_chain | tr '\n' '|')" = "ProtonVPN (DE317)|Test VPN|" ] || {
		echo "vpn_chain should list DE317 (prio 20) before Test VPN (prio 10), Idle VPN (prio 0) excluded"
		echo "got: $(vpn_chain | tr '\n' '|')"
		exit 1
	}
	[ "$(vpn_always | tr '\n' '|')" = "Home Gateway|" ] || {
		echo "vpn_always should list only the autoconnect=yes profile"
		exit 1
	}
	[ "$(conn_family "ProtonVPN (DE317)")" = both ] || {
		echo "conn_family should read 'both' from 0.0.0.0/0;::/0"
		exit 1
	}
	[ "$(conn_family "Test VPN")" = ipv4 ] || {
		echo "conn_family should read 'ipv4' from a v4-only allowed-ips"
		exit 1
	}
	[ "$(conn_endpoint "ProtonVPN (DE317)")" = "149.88.19.225:51820" ] || {
		echo "conn_endpoint should unescape the endpoint colon"
		exit 1
	}

	printf 'CONN=Idle VPN\n' | cmd_up >/dev/null 2>&1 && {
		echo "cmd_up should reject a profile with autoconnect-priority=0 (Idle VPN)"
		exit 1
	}

	# --- conn_family in isolation, v6-only ---
	cat >"$T/bin/nmcli-v6" <<-'EOF'
		#!/bin/sh
		printf '%s\n' 'K= allowed-ips=::/0 endpoint=203.0.113.10\:1 persistent-keepalive=25'
	EOF
	chmod +x "$T/bin/nmcli-v6"
	NMCLI_BIN="$T/bin/nmcli-v6"
	[ "$(conn_family x)" = ipv6 ] || {
		echo "conn_family should read 'ipv6' from a v6-only allowed-ips"
		exit 1
	}

	# --- empty chain must not touch the guard ---
	cat >"$T/bin/nmcli-empty" <<-'EOF'
		#!/bin/sh
		case "$*" in
		"-t -f NAME,TYPE connection show") printf 'Other:vpn\n' ;;
		esac
	EOF
	chmod +x "$T/bin/nmcli-empty"
	NMCLI_BIN="$T/bin/nmcli-empty"
	cat >"$T/bin/nft-unreached" <<-'EOF'
		#!/bin/sh
		echo "nft should not have been called" >&2
		exit 1
	EOF
	chmod +x "$T/bin/nft-unreached"
	NFT_BIN="$T/bin/nft-unreached"
	cmd_arm
	[ "$(state_read)" = unconfigured ] || {
		echo "cmd_arm with an empty chain should write state 'unconfigured'"
		exit 1
	}

	cat >"$T/bin/nmcli" <<-'EOF'
		#!/bin/sh
		case "$*" in
		"-t -f DEVICE,TYPE,STATE dev status")
			printf 'wlo1:wifi:connected\nwg_test:wireguard:connected\ndocker0:bridge:connected\n' ;;
		"-t -f active,ssid dev wifi")
			printf 'no:OtherNet\nyes:HomeNet\n' ;;
		esac
	EOF
	chmod +x "$T/bin/nmcli"
	NMCLI_BIN="$T/bin/nmcli"
	[ "$(detect_uplink)" = wlo1 ] || {
		echo "detect_uplink should pick wlo1, not wg_test or docker0"
		exit 1
	}

	cat >"$T/bin/ip" <<-EOF
		#!/bin/sh
		echo "\$*" >>"$T/ip.log"
		case "\$*" in
		"-4 route show default dev nogw") echo "default dev nogw scope link" ;;
		"-4 route show default dev "*) echo "default via 192.0.2.1 dev wlo1 proto dhcp metric 600" ;;
		"rule del "*) exit 1 ;;
		*) echo "192.0.2.0/24 dev wlo1 proto kernel scope link src 192.0.2.102" ;;
		esac
		exit 0
	EOF
	chmod +x "$T/bin/ip"
	IP_BIN="$T/bin/ip"
	[ "$(lan_subnet wlo1)" = 192.0.2.0/24 ] || {
		echo "lan_subnet parsed the wrong subnet"
		exit 1
	}

	cat >"$T/bin/iw" <<-'EOF'
		#!/bin/sh
		echo "Connected to aa:bb:cc:dd:ee:ff (on wlo1)"
	EOF
	chmod +x "$T/bin/iw"
	IW_BIN="$T/bin/iw"
	[ "$(uplink_key wlo1)" = "HomeNet@aa:bb:cc:dd:ee:ff" ] || {
		echo "uplink_key built the wrong wifi identity"
		exit 1
	}

	cat >"$T/bin/iw-none" <<-'EOF'
		#!/bin/sh
		true
	EOF
	chmod +x "$T/bin/iw-none"
	IW_BIN="$T/bin/iw-none"
	[ "$(uplink_key eno2)" = "wired@eno2" ] || {
		echo "uplink_key should fall back to wired@<dev> off wifi"
		exit 1
	}

	# --- the `direct` policy-routing lane ---
	: >"$T/ip.log"
	direct_up wlo1
	_repl=$(grep -nxF "route replace default via 192.0.2.1 dev wlo1 table $DIRECT_TABLE" "$T/ip.log" | cut -d: -f1)
	[ -n "$_repl" ] || {
		echo "direct_up should build the table from the uplink's own gateway"
		echo "ip calls: $(tr '\n' '|' <"$T/ip.log")"
		exit 1
	}
	_flush=$(grep -nxF "route flush table $DIRECT_TABLE" "$T/ip.log" | head -1 | cut -d: -f1)
	[ -n "$_flush" ] && [ "$_flush" -lt "$_repl" ] || {
		echo "direct_up should clear the old table before it writes the new gateway — a stale gateway blackholes every bypassed packet"
		exit 1
	}
	grep -qxF "rule add fwmark $DIRECT_MARK lookup $DIRECT_TABLE priority $DIRECT_PRIO" "$T/ip.log" || {
		echo "direct_up should install the fwmark rule that reaches the table"
		exit 1
	}

	: >"$T/ip.log"
	direct_up nogw 2>/dev/null
	grep -q "^rule add" "$T/ip.log" && {
		echo "direct_up must NOT install the rule when the uplink has no gateway — a rule pointing at an empty table is a black hole, not a bypass"
		exit 1
	}
	grep -q "^route replace" "$T/ip.log" && {
		echo "direct_up must not write a default route with no gateway to send it to"
		exit 1
	}

	: >"$T/ip.log"
	direct_down
	grep -qxF "rule del fwmark $DIRECT_MARK lookup $DIRECT_TABLE priority $DIRECT_PRIO" "$T/ip.log" || {
		echo "direct_down should delete the rule by its full selector, never by priority alone"
		exit 1
	}

	# --- status sentences ---
	state_write "vpn:ProtonVPN (DE317)"
	[ "$(cmd_status)" = "protected — ProtonVPN (DE317)" ] || {
		echo "status should read the connection name out of vpn:<name>"
		exit 1
	}
	state_write unsecured
	[ "$(cmd_status)" = "not protected — traffic is leaving in the clear" ] || {
		echo "status should describe 'unsecured' in plain words"
		exit 1
	}
	rm -f "$STATE_FILE"
	[ "$(cmd_status)" = "not running — no state recorded" ] || {
		echo "status should not claim 'blocked' when no state file exists"
		exit 1
	}

	# --- help goes to stdout, exit 0 ---
	cmd_help >/dev/null || {
		echo "help should exit 0"
		exit 1
	}

	# --- arm punches the probe hole, and arms last ---
	cat >"$T/bin/nmcli-arm" <<-'EOF'
		#!/bin/sh
		case "$*" in
		"-t -f NAME,TYPE connection show") printf 'Test VPN:wireguard\n' ;;
		"-g connection.autoconnect-priority connection show Test VPN") echo 10 ;;
		"-g connection.autoconnect connection show Test VPN") echo no ;;
		"-g wireguard.peers connection show Test VPN")
			printf '%s\n' 'K1= allowed-ips=0.0.0.0/0 endpoint=203.0.113.10\:51820' ;;
		"-t -f DEVICE,TYPE,STATE dev status") printf 'wlo1:wifi:connected\n' ;;
		esac
	EOF
	chmod +x "$T/bin/nmcli-arm"
	NMCLI_BIN="$T/bin/nmcli-arm"
	cat >"$T/bin/nft-record" <<-EOF
		#!/bin/sh
		[ "\$1" = list ] && exit 0
		echo "\$*" >>"$T/nft.log"
		exit 0
	EOF
	chmod +x "$T/bin/nft-record"
	NFT_BIN="$T/bin/nft-record"
	cat >"$T/bin/no-ipt" <<-'EOF'
		#!/bin/sh
		exit 1
	EOF
	chmod +x "$T/bin/no-ipt"
	IPTABLES_BIN="$T/bin/no-ipt"
	IP6TABLES_BIN="$T/bin/no-ipt"
	: >"$T/ip.log"
	cmd_arm >/dev/null
	grep -qxF "rule add fwmark $DIRECT_MARK lookup $DIRECT_TABLE priority $DIRECT_PRIO" "$T/ip.log" || {
		echo "arm should build the 'direct' lane while the uplink default route is still readable"
		echo "ip calls: $(tr '\n' '|' <"$T/ip.log")"
		exit 1
	}
	grep -qxF 'flush set inet vpn bypass4' "$T/nft.log" || {
		echo "arm should flush bypass4, or a stale dnsmasq-filled bypass survives a re-arm"
		exit 1
	}
	grep -qxF 'flush set inet vpn probes4' "$T/nft.log" || {
		echo "arm should flush probes4, or a stale probe hole survives a re-arm"
		exit 1
	}
	_probe=$(grep -nxF 'add element inet vpn probes4 { 198.51.100.7 }' "$T/nft.log" | cut -d: -f1)
	_arm=$(grep -nxF 'add element inet vpn uplinks { wlo1 }' "$T/nft.log" | cut -d: -f1)
	[ -n "$_probe" ] || {
		echo "arm should open a hole for the host in NM's configured connectivity URI"
		echo "nft calls: $(tr '\n' '|' <"$T/nft.log")"
		exit 1
	}
	[ -n "$_arm" ] && [ "$_probe" -lt "$_arm" ] || {
		echo "arm should punch the probe hole BEFORE it closes the machine"
		exit 1
	}

	# --- protect forgets the opt-out ---
	: >"$UNSECURED_FILE"
	: >"$UPLINK_FILE"
	cat >"$T/bin/nmcli-none" <<-'EOF'
		#!/bin/sh
		true
	EOF
	chmod +x "$T/bin/nmcli-none"
	NMCLI_BIN="$T/bin/nmcli-none"
	cmd_protect >/dev/null
	[ -f "$UNSECURED_FILE" ] && {
		echo "protect should remove the remembered opt-out"
		exit 1
	}
	[ -f "$UPLINK_FILE" ] && {
		echo "protect should remove the remembered uplink"
		exit 1
	}

	echo ok
}

# ---------------------------------------------------------------- dispatch

case "${1:-}" in
arm) cmd_arm ;;
disarm) cmd_disarm ;;
portal) cmd_portal ;;
portal-close) cmd_portal_close ;;
up) cmd_up ;;
unsecure) cmd_unsecure ;;
unsecured-for) cmd_unsecured_for "${2:?usage: unsecured-for <uplink>}" ;;
protect) cmd_protect ;;
auto) cmd_auto ;;
go) cmd_go ;;
devices) cmd_devices ;;
list) cmd_list ;;
status) cmd_status ;;
help) cmd_help ;;
test) cmd_test ;;
*)
	echo "mango-vpnguard: unknown verb '${1:-}' — run 'mango-vpnguard help'" >&2
	exit 1
	;;
esac
