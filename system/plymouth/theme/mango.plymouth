# mango — the plymouth theme that matches the mango-sddm greeter.
# Installed to /usr/share/plymouth/themes/mango/ by system/plymouth/install.sh.
#
# No Font= key on purpose: the script never renders text. Every colour, the
# blurred wallpaper and every glyph arrive as PNGs in dyn/, delivered by the
# early initrd /boot/mango-plymouth.img (see plymouth-theme-sync). The host
# copy of this directory never contains dyn/ — that is what keeps a wallpaper
# switch from needing `mkinitcpio -P`.
#
# It does contain shutdown/: the shutdown and reboot splash runs from the root
# filesystem and never sees the early initrd. Different directory, different
# filenames, so the two can never overwrite each other — plymouth-theme-sync's
# install_shutdown explains why that matters.
[Plymouth Theme]
Name=mango
Description=Material You LUKS prompt for the mango desktop
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/mango
ScriptFile=/usr/share/plymouth/themes/mango/mango.script
