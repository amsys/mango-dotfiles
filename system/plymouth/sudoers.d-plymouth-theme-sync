# Installed to /etc/sudoers.d/plymouth-theme-sync (0440) by
# system/plymouth/install.sh.
#
# Lets matugen's post_hook rebuild the plymouth assets in /boot without a
# password prompt on every wallpaper switch. The target is root-owned and
# not user-writable, and the trailing "" forbids arguments — so this grants
# exactly one fixed action, not root.
%wheel ALL=(root) NOPASSWD: /usr/local/bin/plymouth-theme-sync ""
