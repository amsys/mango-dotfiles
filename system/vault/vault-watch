#!/bin/sh
# vault-watch — detect accidental hooks or injected processes in the vault sandbox.
#
#   vault-watch [--self-test]
#
# Snapshots and diffs against baseline:
# - listening TCP sockets        address + process name, no pid or fd
# - loaded kernel module names   no sizes or use counts
# - /etc/ld.so.preload content
#
# Each snapshot holds only stable values. PIDs, fd numbers, UDP sockets
# and module use counts change all the time and caused a false alert on
# almost every run.
#
# Baselines live in ${XDG_STATE_HOME:-$HOME/.local/state}/vault-watch.
# VAULT_WATCH_DIR overrides the directory.
#
# On a change, calls notify-send. The alert names the changed items and
# replaces the previous alert, so alerts do not stack.
#
# check: vault-watch --self-test

set -eu

XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
VAULT_WATCH_DIR="${VAULT_WATCH_DIR:-$XDG_STATE_HOME/vault-watch}"
# Bump when the snapshot content changes shape; main() then re-baselines.
FORMAT=2

die() { printf 'vault-watch: %s\n' "$*" >&2; exit 1; }
warn() { printf 'vault-watch: %s\n' "$*" >&2; }

take_snapshot() {
	dir="$1"
	mkdir -p "$dir"

	echo "$FORMAT" >"$dir/format"

	# Listening TCP sockets: local address and process name only
	ss -Htlnp 2>/dev/null |
		awk '{ p = $6; sub(/,pid=.*$/, "", p); sub(/^users:\(\(/, "", p); print $4, p }' |
		sort -u >"$dir/sockets" || true

	# Loaded kernel module names
	lsmod 2>/dev/null | awk 'NR > 1 { print $1 }' | sort >"$dir/modules" || true

	# ld.so.preload
	if [ -f /etc/ld.so.preload ]; then
		cat /etc/ld.so.preload >"$dir/preload"
	else
		: >"$dir/preload"
	fi
}

compare_snapshots() {
	baseline_dir="$1"
	current_dir="$2"
	changed=0
	report=""

	for file in sockets modules preload; do
		baseline="$baseline_dir/$file"
		current="$current_dir/$file"

		if [ ! -f "$baseline" ]; then
			continue
		fi

		if ! diff -q "$baseline" "$current" >/dev/null 2>&1; then
			warn "$file changed"
			lines=$(diff "$baseline" "$current" | grep '^[<>]' | head -5)
			report="$report$file:
$lines
"
			changed=1
		fi
	done

	REPORT="$report"
	return $changed
}

self_test() {
	tmpdir=$(mktemp -d)
	trap 'rm -rf "$tmpdir"' EXIT

	baseline="$tmpdir/baseline"
	current="$tmpdir/current"

	# Take first snapshot
	take_snapshot "$baseline"

	# Inject a change: modify the modules file to simulate a new module loading
	printf '%s\n' "injected_module 1024 0" >>"$baseline/modules"

	# Take second snapshot
	take_snapshot "$current"

	# Should detect a change (compare_snapshots returns 1 when there is a change)
	if compare_snapshots "$baseline" "$current" 2>/dev/null; then
		printf '%s\n' "FAIL"
		return 1
	else
		printf '%s\n' "PASS"
		return 0
	fi
}

main() {
	[ "${1:-}" = "--self-test" ] && { self_test; exit $?; }

	# Create baseline if it does not exist, or if an older script version
	# wrote it in a different format (no false alert after an upgrade)
	if [ "$(cat "$VAULT_WATCH_DIR/format" 2>/dev/null)" != "$FORMAT" ]; then
		rm -rf "$VAULT_WATCH_DIR"
		mkdir -p "$VAULT_WATCH_DIR"
		take_snapshot "$VAULT_WATCH_DIR"
		return 0
	fi

	# Take current snapshot
	tmpdir=$(mktemp -d)
	trap 'rm -rf "$tmpdir"' EXIT
	take_snapshot "$tmpdir"

	# Compare and notify on change. The notification id is kept in the
	# state dir, so a new alert replaces the old one instead of stacking.
	if ! compare_snapshots "$VAULT_WATCH_DIR" "$tmpdir" 2>/dev/null; then
		idfile="$XDG_STATE_HOME/vault-watch.notify-id"
		mkdir -p "$XDG_STATE_HOME"
		id=$(cat "$idfile" 2>/dev/null || echo 0)
		notify-send -p -r "$id" -u normal "vault-watch: system state changed" "$REPORT" \
			>"$idfile.tmp" 2>/dev/null && mv "$idfile.tmp" "$idfile"
	fi

	# Update baseline for next run
	rm -rf "$VAULT_WATCH_DIR"
	mv "$tmpdir" "$VAULT_WATCH_DIR"
}

main "$@"
