// ironbar 0.19.0 (Arch extra). Defaults are position=bottom, layer=top,
// height=42 — deliberately unset here: waybar is top/40
// (waybar/config.jsonc:2-4), so the two bars park on opposite edges with
// both exclusive zones intact while both run during T1-T7 development
// (verified: T0 spike S5, IRONBAR.md). T8's cutover flips this to
// position="top" and deletes waybar.
//
// No `tray` module while waybar runs — two StatusNotifierHosts would fight
// over the bus name. Added at T8 in the same commit that removes waybar's.
{
    ironvar_defaults.clk_text = "--:--"
    ironvar_defaults.date_text = ""

    center = [
        {
            type = "custom"
            class = "pill"
            bar = [
                { type = "label" name = "clock" label = "#clk_text" }
                { type = "label" name = "date" label = "#date_text" }
            ]
        }
    ]
}
