[Unit]
Description=mango-powerkey — tiered power-button handling (tap = menu, hold = suspend)
# exec-once (mango/config.conf) had no supervisor: a short read/EOF or a
# device re-enumeration (e.g. a USB keyboard replugged at boot moving which
# eventN node is "Power Button") ended watch() for good, and the power
# button stayed dead — no tap menu, no hold-to-suspend — until the next
# login. Restart=always, not on-failure: find_device() re-runs on every
# restart, so a re-enumerated node is picked up rather than staying lost.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.config/mango/scripts/powerkey.py
Restart=always
RestartSec=2

[Install]
WantedBy=graphical-session.target
