[Unit]
Description=kdeconnectd — KDE Connect daemon for the remote-access bar toggle
# Started/stopped by ironbar/scripts/remote.sh --toggle-kdeconnect, and
# also started by --toggle-vnc when VNC turns on. No [Install] section —
# deliberately not enabled at login.
#
# kdeconnectd binds 0.0.0.0 with no bind-address option; ufw
# (system/remote/install.sh) is the only boundary. kdeconnect ships no unit
# of its own, only /usr/share/dbus-1/services/org.kde.kdeconnect.service.
# A bus call to that name used to D-Bus-activate kdeconnectd outside
# systemd (Chromium does this at each Chromium start); the user-level
# override kdeconnect/org.kde.kdeconnect.service now makes that
# activation fail, so this unit is the only automatic start path.
# /usr/share/applications/org.kde.kdeconnect.daemon.desktop still runs
# the binary directly, but it is NoDisplay=true and needs a deliberate
# manual launch.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/kdeconnectd
Restart=on-failure
RestartSec=2
