[Unit]
Description=wayvnc — VNC server for the remote-access bar toggle
# Started/stopped only by ironbar/scripts/remote.sh --toggle. No [Install]
# section — deliberately not enabled at login, unlike mango-bard.service.
# No auth, no encryption (no ~/.config/wayvnc/config). Binds [::]:5900 —
# a dual-stack v6 socket also serves v4 (net.ipv6.bindv6only=0, the Arch
# default); a second explicit 0.0.0.0:5900 bind fails EADDRINUSE against
# it. ufw (system/remote/install.sh) is the only boundary, restricting it
# to wg_hetzner (10.0.254.0/24, fd10:10::/64) and the mango hotspot
# (10.44.0.0/24). See system/remote/README.md for that call.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/wayvnc [::]:5900
Restart=on-failure
RestartSec=2
