# Never track secrets. fish/conf.d/claude.fish holds machine-local API keys —
# keep them in the KeePassXC keyring instead of copying them here.
fish/conf.d/claude.fish

# Catch-alls. Nothing matches these today; they are here because this repo is
# symlinked into ~/.config, so an app can drop a new file into a tracked
# directory at any time and `git add -A` would sweep it up.
*.kdbx
*.key
*.pem
id_*
.env
.env.*

# Machine-specific, created by install.sh, edited locally.
# theme.json is also rewritten at runtime by switchwall.sh (wallpaperPath,
# accentColor) — track theme.json.example instead.
mango/local.conf
mango/theme.json
git/config.local

# matugen output. Never edit these directly — edit matugen/templates/* and
# run `mango/scripts/switchwall.sh --noswitch`. install.sh symlinks the repo
# in per-file, so these appear as plain files next to the symlinks; they must
# never be tracked or `git status` is permanently dirty after a theme switch.
waybar/style.css
waybar/scripts/claudebar.sh
kitty/theme.conf
swaylock/config
mako/config
rofi/colors.rasi
mango/colors.conf
mango/keybinds.html
wlogout/style.css

# Scratch render used to preview the login screen straight from the working tree
# (`sddm-greeter-qt6 --test-mode --theme system/sddm/theme`). The real one is
# generated by matugen and installed into /usr/share by sddm-theme-sync.
system/sddm/theme/Colors.qml

__pycache__/
*.pyc
*.bak.*
