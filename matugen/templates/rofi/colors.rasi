/* Generated by matugen. Overwritten on every wallpaper/theme switch. */
* {
    background:      #{{colors.background.default.hex_stripped}}FF;
    foreground:       #{{colors.on_background.default.hex_stripped}}FF;
    lightbg:          #{{colors.surface_variant.default.hex_stripped}}FF;
    lightfg:          #{{colors.on_surface_variant.default.hex_stripped}}FF;
    blue:             #{{colors.primary.default.hex_stripped}}FF;
    red:              #{{colors.error.default.hex_stripped}}FF;
    border-color:     #{{colors.outline_variant.default.hex_stripped}}DD;
    surface-low:      #{{colors.surface_container_low.default.hex_stripped}}FF;
    surface-mid:      #{{colors.surface_container.default.hex_stripped}}FF;
    surface-high:     #{{colors.surface_container_high.default.hex_stripped}}FF;
    accent:           #{{colors.primary.default.hex_stripped}}FF;
    accent-soft:      #{{colors.primary_container.default.hex_stripped}}FF;
    on-accent-soft:   #{{colors.on_primary_container.default.hex_stripped}}FF;
    muted:            #{{colors.on_surface_variant.default.hex_stripped}}FF;
    outline:          #{{colors.outline.default.hex_stripped}}FF;
}
