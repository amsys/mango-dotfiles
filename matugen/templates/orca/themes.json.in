{
  "dark": {
    "id": "manual:matugen-dark",
    "name": "Matugen Dark",
    "source": "manual",
    "mode": "dark",
    "sourceLabel": "matugen",
    "importedAt": "1970-01-01T00:00:00.000Z",
    "terminal": {
      "foreground":          "{{colors.on_surface_variant.dark.hex}}",
      "background":          "{{colors.surface.dark.hex}}",
      "cursor":              "{{colors.on_surface.dark.hex}}",
      "cursorAccent":        "{{colors.surface.dark.hex}}",
      "selectionBackground": "{{colors.on_secondary_container.dark.hex}}",
      "selectionForeground": "{{colors.secondary_container.dark.hex}}",
      "black":               "{{colors.surface.dark.hex}}",
      "red":                 "{{colors.term1.dark.hex}}",
      "green":               "{{colors.term2.dark.hex}}",
      "yellow":              "{{colors.term3.dark.hex}}",
      "blue":                "{{colors.term4.dark.hex}}",
      "magenta":             "{{colors.term5.dark.hex}}",
      "cyan":                "{{colors.term6.dark.hex}}",
      "white":               "{{colors.on_surface_variant.dark.hex}}",
      "brightBlack":         "{{colors.outline.dark.hex}}",
      "brightRed":           "{{ colors.term1.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightGreen":         "{{ colors.term2.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightYellow":        "{{ colors.term3.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightBlue":          "{{ colors.term4.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightMagenta":       "{{ colors.term5.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightCyan":          "{{ colors.term6.dark.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightWhite":         "{{colors.on_surface.dark.hex}}",
      "bold":                "{{colors.on_surface.dark.hex}}"
    }
  },
  "light": {
    "id": "manual:matugen-light",
    "name": "Matugen Light",
    "source": "manual",
    "mode": "light",
    "sourceLabel": "matugen",
    "importedAt": "1970-01-01T00:00:00.000Z",
    "terminal": {
      "foreground":          "{{colors.on_surface_variant.light.hex}}",
      "background":          "{{colors.surface.light.hex}}",
      "cursor":              "{{colors.on_surface.light.hex}}",
      "cursorAccent":        "{{colors.surface.light.hex}}",
      "selectionBackground": "{{colors.on_secondary_container.light.hex}}",
      "selectionForeground": "{{colors.secondary_container.light.hex}}",
      "black":               "{{colors.surface.light.hex}}",
      "red":                 "{{colors.term1.light.hex}}",
      "green":               "{{colors.term2.light.hex}}",
      "yellow":              "{{colors.term3.light.hex}}",
      "blue":                "{{colors.term4.light.hex}}",
      "magenta":             "{{colors.term5.light.hex}}",
      "cyan":                "{{colors.term6.light.hex}}",
      "white":               "{{colors.on_surface_variant.light.hex}}",
      "brightBlack":         "{{colors.outline.light.hex}}",
      "brightRed":           "{{ colors.term1.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightGreen":         "{{ colors.term2.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightYellow":        "{{ colors.term3.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightBlue":          "{{ colors.term4.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightMagenta":       "{{ colors.term5.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightCyan":          "{{ colors.term6.light.hex | to_color | auto_lightness: 12.0 | format: "hex" }}",
      "brightWhite":         "{{colors.on_surface.light.hex}}",
      "bold":                "{{colors.on_surface.light.hex}}"
    }
  },
  "dividerDark": "{{colors.outline.dark.hex}}",
  "dividerLight": "{{colors.outline.light.hex}}"
}
