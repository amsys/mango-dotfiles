[KDE]
# Must stay low on a dark scheme. contrast drives KColorScheme's derived
# Light/Midlight/Mid/Dark/Shadow roles, which cannot be set directly — the
# Colors:* groups below have no say over them. Because the background is near
# black, every shade is derived *upward*, so a high contrast makes Light a pale
# grey (#aeaeb3 at contrast=4). Apps that fill large areas with Light rather
# than using it as an edge highlight — the Nextcloud settings panels do — then
# render on_surface text on near-white and become unreadable. 0 keeps Light at
# #424253, ~7:1 against on_surface, still visibly raised against the window.
contrast=0
frameContrast=0.2
widgetStyle=Darkly

