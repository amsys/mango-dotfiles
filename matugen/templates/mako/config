# Generated by matugen (mango-adapted). Overwritten on every wallpaper switch.
# Matches the waybar pill spec: surface_container_low + 12px radius + IBM Plex Sans.

font=IBM Plex Sans 11
background-color={{colors.surface_container_low.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-color={{colors.outline_variant.default.hex}}
progress-color=over {{colors.primary.default.hex}}
border-size=1
border-radius=12
padding=12,16
margin=8
outer-margin=47,10,0,0
width=400
height=160
icon-border-radius=8
max-icon-size=48
max-visible=4
group-by=app-name
layer=overlay

# Auto-dismiss. ignore-timeout=1 is required: apps that send expire_timeout=0
# mean "never expire" per the spec and would otherwise ignore default-timeout.
default-timeout=5000
ignore-timeout=1

# Left click default = mako's own invoke-default-action. Only kitty's own
# D-Bus notifications carry a default action; [app-name=claude] below sets
# its own exec binding since claude-notify.sh sends with none.
on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=none
# on-touch (swipe) defaults to dismiss; left unset intentionally.

[urgency=low]
default-timeout=3000
text-color={{colors.on_surface_variant.default.hex}}

[urgency=critical]
# The only notifications that stay: persist until clicked, error-colored.
default-timeout=0
ignore-timeout=1
border-color={{colors.error.default.hex}}
text-color={{colors.on_surface.default.hex}}
border-size=2

# Fingerprint request (system/fprint-notify). Persists until the helper
# dismisses it — the helper knows when the request ends, mako does not.
# Left click jumps to the window whose sudo asked; exec does not dismiss.
[app-name=fprint]
default-timeout=0
ignore-timeout=1
border-color={{colors.primary.default.hex}}
on-button-left=exec /usr/local/bin/mango-fprint-notify click

# Claude Code notifications (mango/scripts/claude-notify.sh, summary is the
# repo label). group-by is overridden here so notifications from different
# repos don't collapse into one group under the global app-name grouping.
# Left click jumps to the window that sent it and dismisses; the hook sends
# no D-Bus action, so this replaces the (inert here) invoke-default-action.
[app-name=claude]
default-timeout=3000
group-by=app-name,summary
border-color={{colors.term2.default.hex}}
text-color={{colors.term2.default.hex}}
on-button-left=exec $HOME/.config/mango/scripts/claude-notify.sh click "$id"

# Claude is stopped, waiting on the user (permission/plan/question prompt) —
# stays open past the default timeout instead of hiding while ignored.
[app-name=claude category=blocked]
default-timeout=0
