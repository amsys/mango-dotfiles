# Generated by matugen. Overwritten on every wallpaper switch.
#
# Colours mirror the mango-sddm greeter's login card (system/sddm/theme/Main.qml)
# so lock and login read as the same surface: surface_container fill,
# outline_variant border, primary as the focus accent, error for failure.
#
# Vanilla swaylock draws one circle and nothing else — no clock, no card, no
# blur. Matching the palette is the whole of what is possible here. hyprlock
# (installed, unused) is the option if the greeter's layout is ever wanted.

image={{image}}
scaling=fill

color={{colors.surface.default.hex_stripped}}

# Ring plays the card's 1px outline, thicker because it is also the only
# progress feedback swaylock has.
ring-color={{colors.outline_variant.default.hex_stripped}}
ring-clear-color={{colors.primary.default.hex_stripped}}
ring-ver-color={{colors.primary.default.hex_stripped}}
ring-wrong-color={{colors.error.default.hex_stripped}}
line-uses-ring

# Fill is held constant across states so the shape reads as one object, exactly
# like the greeter's card; the ring and text carry the state instead.
inside-color={{colors.surface_container.default.hex_stripped}}
inside-clear-color={{colors.surface_container.default.hex_stripped}}
inside-ver-color={{colors.surface_container.default.hex_stripped}}
inside-wrong-color={{colors.surface_container.default.hex_stripped}}

text-color={{colors.on_surface.default.hex_stripped}}
text-clear-color={{colors.on_surface.default.hex_stripped}}
text-ver-color={{colors.primary.default.hex_stripped}}
text-wrong-color={{colors.error.default.hex_stripped}}
text-caps-lock-color={{colors.on_surface_variant.default.hex_stripped}}

# Per-keystroke arc: primary is the greeter's focus accent, error its failure
# colour — same meaning on either side of the lock.
key-hl-color={{colors.primary.default.hex_stripped}}
bs-hl-color={{colors.error.default.hex_stripped}}
separator-color={{colors.outline_variant.default.hex_stripped}}

# JetBrainsMono to match the greeter exactly. The greeter has no choice: its
# Main.qml renders five Nerd Font PUA glyphs (power, refresh, moon, dropdown,
# arrow) through the same font.family as its text, with no fallback list, so
# it is pinned to a Nerd Font regardless of which UI font the rest of the
# desktop uses. Matching here is deliberate, so the two screens look like one.
font=JetBrainsMono Nerd Font
indicator-radius=100
indicator-thickness=6
indicator-caps-lock
